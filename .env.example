# ── Database (Neon Postgres) ────────────────────────────────
# ⚠️  Do NOT commit real secrets here. Copy this file to `.env` and fill locally.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# ── Auth Secrets ─────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
ADMIN_SEED_EMAIL="admin@satyug.local"
ADMIN_SEED_PASSWORD="ChangeMeInProd!123"
ADMIN_SEED_NAME="Store Owner"

# ── SMS OTP ──────────────────────────────────────────────────
# Optional: leave blank in dev — OTPs print to the server console.
# In prod set Twilio creds OR replace with your SMS provider in
# app/api/send-otp/route.ts.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
DEV_OTP_MASTER_CODE="123456"

# ── HanuOTP (primary SMS provider) ───────────────────────────
# India-native DLT-compliant OTP SMS gateway. When both HanuOTP and Twilio
# are configured, HanuOTP is used first and Twilio serves as fallback on a
# hard failure. To use HanuOTP only, leave the TWILIO_* vars above blank.
#
#   HANUOTP_TEMPLATE_ID defaults to "default" — set to a specific DLT
#   template id if HanuOTP provisions a custom one for your sender.
HANUOTP_API_KEY=""
HANUOTP_TEMPLATE_ID="default"

# ── MSG91 (transactional SMS on order status) ────────────────
# HanuOTP only sends OTP-shaped messages. To notify customers about their
# order status ("out for delivery", "delivered", etc.) you need a
# general-purpose India-native gateway. MSG91 is DLT-compliant and widely
# used by 10-minute grocery apps; the code in lib/sms.ts is drop-in
# compatible with Kaleyra / Gupshup if you'd rather use them.
#
# One-time setup:
#   1. Register a DLT principal entity + sender header at dltconnect.
#   2. Register templates for each status below; MSG91 returns a template id.
#   3. Paste each id into the matching env var. If a status env var is
#      empty, that particular status SMS silently no-ops — orders still
#      succeed, they just don't SMS-notify for that transition.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_DLT_TE_ID_ORDER_CONFIRMED=""
MSG91_DLT_TE_ID_ORDER_OUT_FOR_DELIVERY=""
MSG91_DLT_TE_ID_ORDER_DELIVERED=""
MSG91_DLT_TE_ID_ORDER_CANCELLED=""

# ── Web push (order-status notifications in the browser) ─────
# Generate a fresh key pair ONCE with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The PUBLIC key is exposed to the browser (NEXT_PUBLIC_) so the service
# worker can subscribe; PRIVATE stays server-side; SUBJECT must be a real
# mailto: or https:// URL identifying the sender (Chrome enforces).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:connect@satyuglifestyle.com"

# ── SMTP (transactional email) ───────────────────────────────
# Any SMTP-speaking provider works. GoDaddy Workspace shown below; for
# Office365 / Gmail / SES the shape is the same, just change host/port.
#   Port 465 → SMTP_SECURE=true       (implicit SSL)
#   Port 587 → SMTP_SECURE=false      (STARTTLS)
#
# SMTP_EHLO_NAME must be a valid DNS-shaped string. GoDaddy Workspace
# rejects the default HELO from Node running on Windows / plain host names.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_EHLO_NAME=""

# The master OTP above accepts ANY phone only when this flag is set to "1".
# Leave it blank in production and on any preview / staging deploy — that
# used to be keyed on NODE_ENV, which was too easy to trip. Test-phone
# allowlist below still works regardless of this flag.
ALLOW_MASTER_OTP=""

# Comma-separated E.164 phones that ALWAYS accept DEV_OTP_MASTER_CODE and
# NEVER hit Twilio — even in production. Use for your own dev/QA phones so
# you can log in reliably while Twilio SMS is being fixed. Anyone not on
# this list still goes through real SMS + real OTP.
#   Example: TEST_PHONE_NUMBERS="+919999999999,+911234567890"
TEST_PHONE_NUMBERS=""

# ── Geofencing ───────────────────────────────────────────────
# Single-store setup — flexible via env, no code change needed.
STORE_ID="STORE_PARADIP_MAIN"
STORE_NAME="Satyug 10-Minute Store · Paradip"
STORE_LAT="20.2876869"
STORE_LNG="86.6091121"
DELIVERY_RADIUS_KM="3"           # decimals allowed, e.g. "2.5"
DELIVERY_ETA_MINUTES="10"
GEOFENCE_SIDES="64"              # polygon vertex count; 32–128 is sensible

# Multi-store setup (optional) — overrides the single-store vars above.
# JSON array of {id, name, lat, lng, radiusKm, etaMinutes}.
# STORES_JSON='[{"id":"STORE_A","name":"Paradip","lat":20.2877,"lng":86.6091,"radiusKm":3,"etaMinutes":10},{"id":"STORE_B","name":"Cuttack","lat":20.4625,"lng":85.8830,"radiusKm":4,"etaMinutes":12}]'

# ── Cloudinary Image Storage (optional) ──────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── Payments (Razorpay) ──────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── CORS (for the Android app + any other origin) ────────────
# Comma-separated allowlist. Leave blank to reflect the request Origin.
# Android app (Capacitor / React Native) values you may need:
#   capacitor://localhost,https://localhost,http://localhost
# Or if the Android app calls the API directly with OkHttp / Retrofit,
# there's no browser CORS check and you can leave this blank.
ALLOWED_ORIGINS=""

# ── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google Maps ──────────────────────────────────────────────
# Required for: draggable address pin (customer), delivery-zone polygon editor
# (admin), order thumbnail (admin), and /api/geocode/{reverse,forward}.
# Get one at https://console.cloud.google.com/apis/credentials — enable
#   • Maps JavaScript API
#   • Maps Static API
#   • Geocoding API
# In production, split into two RESTRICTED keys (referrer-restricted browser
# key, IP-restricted server key). Same value in both is fine for local dev.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_KEY=""

# Optional. If GOOGLE_MAPS_SERVER_KEY is blank the geocode routes fall back
# to Nominatim (OpenStreetMap) — this header identifies our app to them per
# their usage policy. Defaults to a project-specific string when unset.
NOMINATIM_USER_AGENT=""
