// Prisma schema for Satyug 10-Minute Grocery Store.
// Neon Postgres in production, works with any Postgres locally.

generator client {
  provider      = "prisma-client-js"
  // Vercel uses RHEL 9 + OpenSSL 3. Include both so the generated engine
  // works locally on Windows/macOS AND when deployed to Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Auth: separate customer (phone/OTP) and admin (email/password)
// ─────────────────────────────────────────────────────────────

model Customer {
  id            String    @id @default(cuid())
  phone         String    @unique // stored in E.164, e.g. "+919876543210"
  name          String?
  email         String?
  isBlocked     Boolean   @default(false)
  // Bumped to invalidate every outstanding JWT for this account — used on
  // block, on sign-out-everywhere, or on any credential/permission change.
  // Baked into the JWT at sign time; checked in requireAuth on every request.
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  addresses     Address[]
  orders        Order[]

  @@index([createdAt])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Same purpose as Customer.tokenVersion — bump to kill every outstanding
  // admin session (e.g. after a password change).
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String // "Home" | "Work" | "Other"
  houseNo      String // house / flat / floor number
  area         String // street, area, sector, locality (from reverse geocoding)
  city         String
  pincode      String
  lat          Float?
  lng          Float?
  landmark     String? // "Near XYZ Park", "Opposite ABC Store"
  contactName  String? // person receiving the delivery (may not be the account holder)
  contactPhone String? // call-at-delivery number
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([customerId])
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id            String        @id // stable slug: "vegetables", "fruits", ...
  name          String
  icon          String // emoji shortcut, e.g. "🥦"
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  subcategories Subcategory[]
  products      Product[]
  createdAt     DateTime      @default(now())
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  sortOrder  Int       @default(0)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Product {
  id              String       @id @default(cuid())
  sku             String       @unique
  name            String
  description     String?
  brand           String? // "Amul", "Britannia" — for the brand filter
  isVeg           Boolean      @default(true) // veg-only filter chip; false = non-veg / egg
  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id])
  subcategoryId   String?
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id])
  price           Int // in paise (₹1 = 100 paise) — always integer
  originalPrice   Int? // MRP, in paise
  costPrice       Int? // in paise
  stock           Int          @default(0)
  weight          String // "500 g", "1 kg", ...
  imageUrl        String
  // Additional images for the PDP carousel. Empty by default; the PDP falls
  // back to `imageUrl` alone when this array is empty. Ordered — index 0 is
  // the first slide *after* the primary imageUrl (which is always slide 0).
  images          String[]     @default([])
  rating          Float        @default(4.5)
  // Number of ratings/reviews behind the average — the card shows this
  // "(N)" instead of star icons (Blinkit-parity). Default 0; admin can seed
  // a starter value before real reviews arrive.
  ratingCount     Int          @default(0)
  // ─── Blinkit-parity attribute fields ───────────────────────
  // Optional scalar attributes surfaced on the PDP. Fresh produce typically
  // leaves them null; packaged FMCG fills type/shelfLife/countryOfOrigin
  // plus ingredients + nutrition. Admin renders these behind collapsible
  // sections so the form doesn't feel bloated for produce SKUs.
  type            String?      // "Namkeen & Mixtures", "Chocolate Bar", "Body Wash"
  shelfLife       String?      // "180 days", "6 months from mfg."
  countryOfOrigin String?      @default("India")
  ingredients     String?      // Free-text; one paragraph or newline list
  // Nutrition per 100 g / ml — {energy, protein, carbs, sugar, fat,
  // satFat, transFat, sodium, servingSize} — all strings so units survive.
  nutrition       Json?
  deliveryMinutes Int          @default(10)
  tags            String[]     @default([])
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  variants        ProductVariant[]
  orderItems      OrderItem[]
  inventoryTxs    InventoryTx[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive])
  @@index([brand])
}

/**
 * A single Product can have multiple SKUs — 250 g pack, 500 g pack, family pack, etc.
 * If a product has ZERO variants, the product itself acts as the sole variant
 * (backward-compat with older single-SKU catalog items).
 */
model ProductVariant {
  id            String   @id @default(cuid())
  sku           String   @unique
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label         String // "500 g", "1 L Family Pack", "Small"
  price         Int // paise
  originalPrice Int? // paise (MRP)
  stock         Int      @default(0)
  imageUrl      String? // optional — falls back to product image
  sortOrder     Int      @default(0)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]

  @@index([productId])
}

model InventoryTx {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int // +receive / -sale / -adjustment
  reason    String // "sale", "restock", "adjustment", "return"
  orderId   String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Orders — NO rider (admin delivers themselves)
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  pending // just placed, awaiting confirmation
  confirmed // admin accepted, being packed
  packed // ready to leave the store
  out_for_delivery // admin has left with the order
  delivered // handed to customer
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  cod
  razorpay
}

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique // human-facing: "SL-249301"
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  customerNameSnap   String // snapshot at time of order
  customerPhoneSnap  String
  deliveryAddress    String // full formatted address snapshot
  lat                Float?
  lng                Float?
  // Client-supplied idempotency key — a stable random id the storefront sends
  // once per Place Order tap. Rapid double-taps (or the "the payment sheet
  // reopened but I already got a success" retry) resolve to the same row
  // instead of creating a duplicate order.
  idempotencyKey     String?       @unique
  status             OrderStatus   @default(pending)
  subtotal           Int // paise
  discount           Int           @default(0)
  deliveryFee        Int           @default(0)
  handlingFee        Int           @default(0) // small packaging / convenience fee, paise
  tip                Int           @default(0) // customer's optional tip to the owner, paise
  total              Int
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(pending)
  couponCode         String?
  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?
  refundAmount       Int           @default(0)
  notes              String? // delivery instructions ("don't ring bell", etc.)
  // Slot booking — null = "deliver now" (instant). Set when the customer
  // picks a specific slot at checkout; slot is [scheduledFor, scheduledFor + slotDurationMinutes).
  scheduledFor       DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  items              OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([scheduledFor])
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String? // null = the product itself (no explicit variant)
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  nameSnap   String
  imageSnap  String?
  weightSnap String? // snapshot of variant.label OR product.weight
  unitPrice  Int // paise at time of order
  quantity   Int

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// Promotions
// ─────────────────────────────────────────────────────────────

enum CouponType {
  flat
  percent
  free_shipping
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  description     String?
  type            CouponType
  value           Int // paise (flat) or percent (percent) or shipping-fee (free_shipping)
  maxDiscount     Int? // paise cap for percent coupons
  minOrder        Int        @default(0) // paise
  usageLimit      Int? // null = unlimited
  timesUsed       Int        @default(0)
  isActive        Boolean    @default(true)
  validFrom       DateTime   @default(now())
  validUntil      DateTime?
  createdAt       DateTime   @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  badge     String? // e.g. "10minute Flash Deal"
  code      String? // coupon code to advertise
  imageUrl  String
  linkUrl   String? // deep link on tap
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Ops / analytics
// ─────────────────────────────────────────────────────────────

// NOTE: DeliveryZone (pincode-tiered fees) was removed as unused —
// single-store model uses StoreSetting.deliveryRadiusKm / deliveryPolygon.
// Restore this model + prisma/seed.ts's zones block together if pincode
// tiers come back.

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String // bcrypt hash of OTP
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

/**
 * Singleton store-wide configuration. The app enforces one row via
 * `where: { id: "singleton" }` — the seed / API always uses that id.
 *
 * `weeklyHours` is a JSON blob keyed by day-of-week (0 = Sunday … 6 = Sat):
 *   { "0": { open: "09:00", close: "22:00", closed: false }, ... }
 * A day marked `closed: true` overrides the times entirely.
 *
 * `isOpen` is a manual master switch — even if within business hours,
 * if `isOpen === false` the storefront blocks orders. Use for lunch breaks,
 * emergencies, vacation.
 */
model StoreSetting {
  id                 String   @id @default("singleton")
  isOpen             Boolean  @default(true) // manual override
  closedMessage      String? // e.g. "We're closed for Diwali — back tomorrow!"
  weeklyHours        Json     @default("{}") // see comment above
  etaMinutesOverride Int? // temp bump ("we're busy, +5 min today")
  // Live-editable geofence override (falls back to env vars in lib/geofence.ts)
  storeLat           Float?
  storeLng           Float?
  deliveryRadiusKm   Float?
  // Drawn delivery polygon — when present, WINS over the circular radius above.
  // JSON: [[lng, lat], [lng, lat], ...] — a single closed ring (last==first).
  deliveryPolygon    Json?
  // Fee configuration — all in paise. Server reads these on every order-create
  // so a change here immediately affects the next checkout without a redeploy.
  // Historically these lived as compile-time constants in the orders route.
  deliveryFeeDefault    Int     @default(1900) // ₹19 — flat fee when below freeAboveThreshold
  freeAboveThreshold    Int     @default(19900) // ₹199 — subtotal at which delivery + handling are waived
  handlingFeeDefault    Int     @default(200) // ₹2 packaging / convenience fee
  // Slot-based delivery config
  slotEnabled          Boolean @default(false) // if false, only "deliver now" is offered
  slotDurationMinutes  Int     @default(60) // slot length; 30 / 60 / 90 typical
  slotCapacity         Int     @default(20) // max orders per slot
  slotLeadMinutes      Int     @default(30) // earliest slot must start at least N min from now
  // Rotating placeholders shown in the storefront header search bar. Cycled
  // every ~3 s in the CustomerHeader. Edit from admin/settings.
  searchPlaceholders   String[] @default(["bread", "milk", "eggs", "chips", "paneer", "curd", "rice", "chocolate"])
  // Merchandising pins — { [categoryId]: productId[] }. Feeds the PDP
  // "Top in this category" rail: pinned products lead, then algorithmic
  // sort fills the rest. Empty / missing categoryId falls back to the
  // pure algorithmic sort we shipped in Phase C. Edit from admin/settings.
  featuredByCategory   Json?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

/**
 * Web-push subscription. One row per (customer, browser/device) pair — a
 * given customer may have several if they've opted in on multiple browsers.
 * Written by `POST /api/push/subscribe`; consumed by lib/push.ts on order
 * status changes to fan out notifications.
 *
 * The unique constraint on `endpoint` prevents duplicates when the same
 * browser re-subscribes (e.g. after clearing site data + re-opting in).
 */
model PushSubscription {
  id         String   @id @default(cuid())
  customerId String?
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([customerId])
}

/**
 * Support ticket — customer help request from `/support`. Previously lived
 * in the file-DB and lost data across serverless cold starts. Now durable.
 */
model SupportTicket {
  id            String   @id @default(cuid())
  customerId    String?
  customerPhone String?
  customerName  String?
  message       String
  status        String   @default("open") // "open" | "resolved"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/**
 * Dark-store hub (physical fulfilment location). Multi-store setups store
 * per-store lat/lng, service radius, and staff-facing display metadata here.
 * A single-store deployment can leave this table with one row.
 */
model DarkStore {
  id           String   @id @default(cuid())
  name         String
  code         String?  @unique
  address      String
  city         String
  pincode      String
  lat          Float
  lng          Float
  radiusKm     Float    @default(3)
  etaMinutes   Int      @default(10)
  isActive     Boolean  @default(true)
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

model AbandonedCart {
  id             String   @id @default(cuid())
  customerId     String?
  phoneSnap      String?
  emailSnap      String?
  nameSnap       String?
  itemsJson      Json // snapshot of cart items
  totalValue     Int // paise
  totalItems     Int
  lastActiveStep String // "Basket Drawer" | "Delivery Address Selection" | "Payment Gateway"
  recoveryPingSent Boolean @default(false)
  lat            Float?
  lng            Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}
